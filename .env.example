# 配置键参考。实际使用 private/DEMO.env.ps1 或 private/ALIPAY_SANDBOX.env.ps1。
RECONIS_ENV=DEMO
DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=ReconisDemo;encrypt=true;trustServerCertificate=true
DB_USER=reconis_demo
DB_PASSWORD=
DATA_DIR=../data/demo
PORT=8080
COOKIE_SECURE=false
QUERY_DELAY_MS=15000
REPORT_FONT=C:/Windows/Fonts/simsun.ttc
# 沙箱使用 ReconisSandbox 和 ../data/sandbox；只允许支付宝沙箱网关。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=
